# Copy to .env (git-ignored) and set your Google Cloud project ID. No API key is needed:
# locally Refrain uses your Google sign-in (gcloud auth application-default login).

# Send Gemini calls to Vertex AI on Google Cloud.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Bill local AI calls to the same project, not to the project saved with your gcloud sign-in.
GOOGLE_CLOUD_QUOTA_PROJECT=your-project-id

# 1 = the simulated coach (tests and offline UI work only; every answer is labelled "Simulated coach").
REFRAIN_FAKE_AI=0
